{
  "name": "Incident Response - Alert Intake & Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incident-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 300],
      "webhookId": "incident-alert"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "coordinator_base",
              "value": "http://localhost:8000",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "scenario_id",
              "value": "={{ $json.body.scenario_id || $json.scenario_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.coordinator_base }}/incidents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scenario_id: $json.scenario_id }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "node-start-incident",
      "name": "Start Incident (Triage->Diagnosis->Plan)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const state = $input.first().json;\nconst severity = state.triage ? state.triage.severity : 'unknown';\nconst channel = ['critical', 'high'].includes(severity) ? 'pager-oncall' : 'ops-alerts';\nconst plan = state.plan ? state.plan.ranked_recommendation : 'n/a';\nconst message = `[${severity.toUpperCase()}] Incident ${state.incident_id} on ${state.service}: ${state.triage ? state.triage.summary : ''} | Recommended: ${plan} | Review & approve at /incidents/${state.incident_id}/decision`;\nreturn [{ json: { ...state, routing_channel: channel, routing_message: message } }];\n"
      },
      "id": "node-compute-routing",
      "name": "Compute Routing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.coordinator_base }}/notify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.routing_channel, message: $json.routing_message }) }}",
        "options": {}
      },
      "id": "node-notify-alert",
      "name": "Notify Alert Routed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ incident_id: $json.incident_id, status: $json.status, routed_to: $json.routing_channel }) }}",
        "options": {}
      },
      "id": "node-ack-webhook",
      "name": "Ack Alert Source",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.coordinator_base }}/approvals/{{ $('Compute Routing').first().json.incident_id }}",
        "options": {}
      },
      "id": "node-poll-approval",
      "name": "Poll Approval Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "awaiting_approval",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-pending",
      "name": "Still Awaiting Human Decision?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1380, 480]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "node-wait",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1380, 660]
    },
    {
      "parameters": {
        "jsCode": "const approval = $input.first().json;\nconst final = $('Compute Routing').first().json;\nconst status = approval.status;\nconst message = status === 'rejected'\n  ? `Incident ${final.incident_id}: human REJECTED the remediation plan. No changes were executed.`\n  : status === 'closed'\n  ? `Incident ${final.incident_id}: remediation executed and postmortem generated. Status: closed.`\n  : `Incident ${final.incident_id}: pipeline ended with status '${status}'.`;\nreturn [{ json: { incident_id: final.incident_id, status, channel: final.routing_channel, message } }];\n"
      },
      "id": "node-build-completion",
      "name": "Build Completion Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.coordinator_base }}/notify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, message: $json.message }) }}",
        "options": {}
      },
      "id": "node-notify-completion",
      "name": "Notify Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 400]
    }
  ],
  "connections": {
    "Alert Webhook": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Start Incident (Triage->Diagnosis->Plan)", "type": "main", "index": 0 }]] },
    "Start Incident (Triage->Diagnosis->Plan)": { "main": [[{ "node": "Compute Routing", "type": "main", "index": 0 }]] },
    "Compute Routing": {
      "main": [
        [
          { "node": "Notify Alert Routed", "type": "main", "index": 0 },
          { "node": "Poll Approval Status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Notify Alert Routed": { "main": [[{ "node": "Ack Alert Source", "type": "main", "index": 0 }]] },
    "Poll Approval Status": { "main": [[{ "node": "Still Awaiting Human Decision?", "type": "main", "index": 0 }]] },
    "Still Awaiting Human Decision?": {
      "main": [
        [{ "node": "Wait 5s", "type": "main", "index": 0 }],
        [{ "node": "Build Completion Message", "type": "main", "index": 0 }]
      ]
    },
    "Wait 5s": { "main": [[{ "node": "Poll Approval Status", "type": "main", "index": 0 }]] },
    "Build Completion Message": { "main": [[{ "node": "Notify Completion", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
