# --- Google ADK / Gemini ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Model used by every specialist agent. If the key above is missing/invalid,
# or the model name is retired/unavailable, agents automatically fall back to
# a deterministic rule-based reasoner (see incident_response/agents/*.py
# `_heuristic_*` functions) instead of crashing. Run
# `curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"`
# to see which models your key currently supports if this one stops working.
ADK_MODEL=gemini-2.5-flash

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-response-adk
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- A2A agent server ports (each specialist runs its own A2A server) ---
AGENT_HOST=127.0.0.1
MONITORING_AGENT_PORT=8001
DIAGNOSTIC_AGENT_PORT=8002
REMEDIATION_AGENT_PORT=8003
POSTMORTEM_AGENT_PORT=8004

# --- Coordinator / HITL API (called by n8n and the CLI demo) ---
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=8110

# --- Chaos injection (exercise error handling / graceful degradation) ---
# 1 = scenarios can inject simulated tool/API failures; 0 = disable
CHAOS_MODE=1

# --- Optional: n8n webhook that fronts the coordinator for alert routing ---
# If unset, the CLI demo posts directly to the coordinator API.
N8N_ALERT_WEBHOOK_URL=

# --- Optional: skip the HITL gate for well-understood, low-stakes plans ---
# Off by default -- every incident stops for a human unless you turn this on.
# When enabled, an incident auto-approves (and the coordinator's own decision
# is recorded, reviewer="system (auto-approved: low risk)") only if ALL of:
#   - no stage (triage/diagnosis/plan) fell back to degraded/rule-based mode
#   - the leading root-cause hypothesis's confidence >= the threshold below
#   - every step in the recommended remediation goal is "low" risk
# Anything short of that still stops for a human. See coordinator.py
# `_auto_approval_decision`.
AUTO_APPROVE_LOW_RISK=0
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.75
